#!/bin/bash
#
# Portable deployment bundler for LOUHI
# Generated by CMake - do not edit directly
#
# This script collects the built application and all its shared library
# dependencies into a self-contained portable directory.

set -euo pipefail

DEPLOY_DIR="@DEPLOY_DIR@"
DEPLOY_BIN_DIR="@DEPLOY_BIN_DIR@"
DEPLOY_LIB_DIR="@DEPLOY_LIB_DIR@"
DEPLOY_PLUGIN_DIR="@DEPLOY_PLUGIN_DIR@"
QT5_PLUGIN_DIR="@QT5_PLUGIN_DIR@"
CMAKE_SOURCE_DIR="@CMAKE_SOURCE_DIR@"
CMAKE_BINARY_DIR="@CMAKE_BINARY_DIR@"

echo ""
echo "=== LOUHI Portable Deployment ==="
echo "Target: ${DEPLOY_DIR}"
echo ""

# Clean and create directory structure
rm -rf "${DEPLOY_DIR}"
mkdir -p "${DEPLOY_DIR}"

# ------------------------------------------------------------------
# Step 1: Install our application (this applies INSTALL_RPATH correctly)
# ------------------------------------------------------------------
echo ">> Installing application (cmake --install)..."
DESTDIR="${DEPLOY_DIR}" cmake --install "${CMAKE_BINARY_DIR}" --prefix / > /dev/null 2>&1 || {
    echo "   cmake --install failed: $?"
    echo "   Falling back to manual copy..."
    mkdir -p "${DEPLOY_BIN_DIR}" "${DEPLOY_LIB_DIR}" "${DEPLOY_PLUGIN_DIR}"
    cp -a "${CMAKE_BINARY_DIR}/louhi" "${DEPLOY_BIN_DIR}/"
    cp -a "${CMAKE_BINARY_DIR}/libplugininterface.so" "${DEPLOY_LIB_DIR}/"
    for plugin in natsplugin messageviewerplugin takplugin locationplugin mapplugin; do
        [ -f "${CMAKE_BINARY_DIR}/plugins/${plugin}.so" ] && \
            cp -a "${CMAKE_BINARY_DIR}/plugins/${plugin}.so" "${DEPLOY_PLUGIN_DIR}/"
    done
}
echo "   done"

# Ensure lib/ exists
mkdir -p "${DEPLOY_LIB_DIR}"

# Copy .json metadata files for plugins
echo ">> Copying plugin metadata..."
mkdir -p "${DEPLOY_PLUGIN_DIR}"
for json_file in "${CMAKE_SOURCE_DIR}"/plugins/*.json; do
    if [ -f "${json_file}" ]; then
        cp -a "${json_file}" "${DEPLOY_PLUGIN_DIR}/"
    fi
done

# ------------------------------------------------------------------
# Step 2: Resolve and copy shared library dependencies
# ------------------------------------------------------------------
echo ">> Resolving shared library dependencies..."

declare -A COPIED_LIBS
COPIED_LIBS["copied"]="1"  # dummy entry to init

collect_deps() {
    local binary="$1"
    local ldd_output
    ldd_output=$(ldd "${binary}" 2>/dev/null || true)

    while IFS= read -r line; do
        if [[ "${line}" =~ ([^[:space:]]+)[[:space:]]*'=>'[[:space:]]*(/[^[:space:]]+) ]]; then
            local lib_path="${BASH_REMATCH[2]}"
            local lib_name
            lib_name=$(basename "${lib_path}")

            [[ "${lib_name}" == ld-linux-* ]] && continue
            [[ "${lib_name}" == linux-vdso* ]] && continue

            local real_path
            real_path=$(readlink -f "${lib_path}" 2>/dev/null || echo "${lib_path}")
            local real_name
            real_name=$(basename "${real_path}")

            [[ -n "${COPIED_LIBS[${real_name}]-}" ]] && continue
            COPIED_LIBS["${real_name}"]="1"

            # Skip if the file is already inside our deploy directory
            [[ "${real_path}" == "${DEPLOY_DIR}"* ]] && continue

            cp -aL --remove-destination "${real_path}" "${DEPLOY_LIB_DIR}/" 2>/dev/null || \
            cp -aL "${real_path}" "${DEPLOY_LIB_DIR}/"

            if [ "${lib_name}" != "${real_name}" ]; then
                ln -sf "${real_name}" "${DEPLOY_LIB_DIR}/${lib_name}" 2>/dev/null || true
            fi

            echo "   bundled: ${real_name}"
        fi
    done <<< "${ldd_output}"
}

# Collect all our binaries
ALL_BINARIES=()
while IFS= read -r -d '' f; do
    ALL_BINARIES+=("$f")
done < <(find "${DEPLOY_DIR}" \( -type f -name "*.so*" -o -type f -executable -name "louhi" \) -print0)

for binary in "${ALL_BINARIES[@]}"; do
    if [ -f "${binary}" ]; then
        echo "   analysing: ${binary#${DEPLOY_DIR}/}"
        collect_deps "${binary}"
    fi
done

# ------------------------------------------------------------------
# Step 3: Copy Qt platform plugins (and their deps)
# ------------------------------------------------------------------
echo ">> Copying Qt platform plugins..."
if [ -d "${QT5_PLUGIN_DIR}" ]; then
    for plugin in "${QT5_PLUGIN_DIR}"/platforms/*.so; do
        if [ -f "${plugin}" ]; then
            mkdir -p "${DEPLOY_PLUGIN_DIR}/platforms"
            cp -aL "${plugin}" "${DEPLOY_PLUGIN_DIR}/platforms/"
            echo "   platform plugin: $(basename "${plugin}")"
            collect_deps "${plugin}"
        fi
    done
    for plugin in "${QT5_PLUGIN_DIR}"/imageformats/*.so; do
        if [ -f "${plugin}" ]; then
            mkdir -p "${DEPLOY_PLUGIN_DIR}/imageformats"
            cp -aL "${plugin}" "${DEPLOY_PLUGIN_DIR}/imageformats/"
            echo "   image plugin: $(basename "${plugin}")"
            collect_deps "${plugin}"
        fi
    done
else
    echo "   WARNING: Qt5 plugin directory not found at ${QT5_PLUGIN_DIR}"
fi

# ------------------------------------------------------------------
# Step 4: Fix RPATH on binaries for full standalone portability
# ------------------------------------------------------------------
PATCHELF=$(command -v patchelf || echo "")
CHRPATH=$(command -v chrpath || echo "")

if [ -n "${PATCHELF}" ]; then
    echo ">> Setting RPATH with patchelf..."
    for f in "${DEPLOY_BIN_DIR}/louhi" "${DEPLOY_PLUGIN_DIR}"/*.so "${DEPLOY_LIB_DIR}"/*.so; do
        [ -f "${f}" ] && ${PATCHELF} --set-rpath '$ORIGIN/../lib' "${f}" 2>/dev/null || true
    done
    echo "   done"
elif [ -n "${CHRPATH}" ]; then
    echo ">> Setting RPATH with chrpath..."
    for f in "${DEPLOY_BIN_DIR}/louhi" "${DEPLOY_PLUGIN_DIR}"/*.so "${DEPLOY_LIB_DIR}"/*.so; do
        if [ -f "${f}" ]; then
            # chrpath can only modify existing RPATH; the install step sets it
            ${CHRPATH} -r '$ORIGIN/../lib' "${f}" 2>/dev/null || true
        fi
    done
    echo "   done"
fi

# ------------------------------------------------------------------
# Step 5: Create launcher script
# ------------------------------------------------------------------
echo ">> Creating launcher script..."
cat > "${DEPLOY_DIR}/run.sh" << 'SCRIPT'
#!/bin/bash
# Portable launcher for LOUHI
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LD_LIBRARY_PATH="${DIR}/lib:${LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="${DIR}/plugins:${QT_PLUGIN_PATH}"
exec "${DIR}/bin/louhi" "$@"
SCRIPT
chmod +x "${DEPLOY_DIR}/run.sh"

# ------------------------------------------------------------------
# Summary
# ------------------------------------------------------------------
echo ""
echo "=== Deployment complete ==="
echo "Bundle size: $(du -sh "${DEPLOY_DIR}" | cut -f1)"
echo "Libraries:   $(find "${DEPLOY_LIB_DIR}" -name '*.so*' 2>/dev/null | wc -l) files"
echo "Plugins:     $(find "${DEPLOY_PLUGIN_DIR}" -name '*.so' 2>/dev/null | wc -l) files"
echo ""
echo "To run:  ${DEPLOY_DIR}/run.sh"
echo ""
